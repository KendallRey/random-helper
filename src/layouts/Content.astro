---
const props = Astro.props;
---

<div id="container" {...props}>
  <slot />
</div>

<style>
  #container {
    color: white;
    background: rgba(0, 0, 0, 0.7);
    flex-grow: 1;
    display: flex;
    border-radius: 2rem;
    min-height: calc(100vh - 8rem);
    justify-content: center;
    z-index: 1;
  }
</style>
