{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@components": ["src/components"],
      "@assets/*": ["src/assets/*"],
      "@assets": ["src/assets"],
      "@layouts/*": ["src/layouts/*"],
      "@layouts": ["src/layouts"],
      "@paraglide/*": ["src/paraglide/*"],
      "@paraglide": ["src/paraglide"],
    }
  }
}